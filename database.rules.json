{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^nd-[0-9]{4}$/)",
        "peers": {
          "$peer": {
            ".write": "$room.matches(/^nd-[0-9]{4}$/)",
            ".validate": "!newData.exists() || (newData.child('p').isString() && newData.child('p').val().length < 4096)"
          }
        }
      }
    },
    "stats": {
      ".read": true,
      "total": {
        "$k": {
          ".write": "newData.exists() && $k.matches(/^(visits|visitors|dayVisitors|single|multi)$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "days": {
        "$d": {
          "$k": {
            ".write": "newData.exists() && $d.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $k.matches(/^(visits|visitors|dayVisitors|single|multi)$/)",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      },
      "g": {
        "$s": {
          "total": {
            "$k": {
              ".write": "newData.exists() && $s.matches(/^[a-z]{2,20}$/) && $k.matches(/^(visits|visitors|dayVisitors|single|multi)$/)",
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            }
          },
          "days": {
            "$d": {
              "$k": {
                ".write": "newData.exists() && $s.matches(/^[a-z]{2,20}$/) && $d.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $k.matches(/^(visits|visitors|dayVisitors|single|multi)$/)",
                ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
              }
            }
          }
        }
      }
    },
    "rank": {
      ".read": true,
      "$g": {
        "$p": {
          ".write": "newData.exists() && $g.matches(/^(baseball|clay|soccer|basketball|bowling|tennis|ballboy|surf)$/) && $p.matches(/^[A-Z0-9+!'-]{1,10}_[0-9]{1,2}$/)",
          ".validate": "newData.hasChildren(['n', 'u', 's', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9 .'-]{1,10}$/)"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}$/)"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= 100000 && ($g.matches(/^(baseball|tennis|soccer)$/) || newData.val() === newData.parent().child('r').val() * (newData.parent().child('lv').val() + 4))"
          },
          "r": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20000"
          },
          "lv": {
            ".validate": "newData.val() === 0 || newData.val() === 1 || newData.val() === 2"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$o": {
            ".validate": false
          }
        }
      }
    }
  }
}
